POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workforcesync
POSTGRES_USER=workforcesync
# Set a local password before starting Compose. Never commit .env.
POSTGRES_PASSWORD=
SOURCE_API_URL=http://localhost:8000
LOG_LEVEL=INFO
BATCH_SIZE=500
PAGE_SIZE=100
# Fraction rejected that aborts a run; 1 allows row-level quarantine without aborting.
MAX_REJECTED_FRACTION=1.0
# Optional: connect to a self-hosted Prefect server; otherwise Prefect runs locally.
# PREFECT_API_URL=http://localhost:4200/api
